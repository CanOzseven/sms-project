<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0e14"
    tools:context=".MainActivity">

    <!-- Setup Screen -->
    <LinearLayout
        android:id="@+id/setupScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS PANEL"
            android:textColor="#ff6b35"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cihaz Kurulumu"
            android:textColor="#8b95a5"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#151922"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ Bu kurulum sadece BİR KERE yapılır"
                android:textColor="#00d4aa"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunucu Adresi"
                android:textColor="#8b95a5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/serverUrlInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1e2430"
                android:text="http://158.220.101.218"
                android:hint="http://158.220.101.218"
                android:textColorHint="#4a5568"
                android:textColor="#e6e8eb"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktivasyon Kodu (8 karakter)"
                android:textColor="#8b95a5"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/activationCodeInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1e2430"
                android:hint="XXXXXXXX"
                android:textColorHint="#4a5568"
                android:textColor="#e6e8eb"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters"
                android:maxLength="8"
                android:letterSpacing="0.2"
                android:paddingHorizontal="12dp"
                android:gravity="center" />

        </LinearLayout>

        <Button
            android:id="@+id/activateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🚀 Cihazı Kaydet ve Başlat"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:background="#ff6b35"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ff4757"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Active Screen (Terminal Style) -->
    <ScrollView
        android:id="@+id/activeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#151922"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$ ✓ Cihaz kaydedildi"
                    android:textColor="#00d4aa"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/deviceNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➜ Device: -"
                    android:textColor="#e6e8eb"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/statusIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="➜ Status: ACTIVE █"
                    android:textColor="#00d4aa"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Connection Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#151922"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Sunucuya bağlı [● LIVE]"
                    android:textColor="#00d4aa"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/uptimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ Uptime: 00:00:00"
                    android:textColor="#8b95a5"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/lastSyncText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ Son sync: -"
                    android:textColor="#8b95a5"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#151922"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Toplam SMS"
                        android:textColor="#8b95a5"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/totalSmsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#ff6b35"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#151922"
                    android:padding="16dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☁️ Sync Edildi"
                        android:textColor="#8b95a5"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/syncedSmsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#00d4aa"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Activity Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#151922"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Aktivite Logu"
                    android:textColor="#ff6b35"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/activityLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Loglar buraya dinamik eklenecek -->
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
