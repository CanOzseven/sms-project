# SMS Panel Backend - Environment Variables
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin

# MongoDB bağlantı URI'si
MONGODB_URI=mongodb://localhost:27017/sms-panel

# JWT Secret Key - Production'da güçlü bir anahtar kullanın!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server port
PORT=3000

# Environment (development, production)
NODE_ENV=development

# CORS origin (Frontend URL'i)
CORS_ORIGIN=*

# Admin credentials (ilk kurulumda oluşturulur)
# Email: admin@sms-panel.com
# Password: admin123
